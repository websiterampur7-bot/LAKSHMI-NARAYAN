# Environment Configuration - Copy this to .env for local development

# Server Port (default: 3000)
PORT=3000

# Node Environment (development or production)
NODE_ENV=development

# PostgreSQL Connection String (for production - takes precedence)
# DATABASE_URL=postgresql://user:password@hostname:port/database

# OR PostgreSQL Individual Configuration (for local development)
# Set these for local PostgreSQL development, or use DATABASE_URL.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lakshmi_narayan

# Supabase Auth (use the public anon key only; never use service_role in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
